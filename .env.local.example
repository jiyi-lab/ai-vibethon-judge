# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# .env* 는 .gitignore 대상이라 저장소에 올라가지 않습니다.
#
# 둘 다 비워두면 Supabase 없이 로컬 파일 저장소(ai-vibethon.local.json)로 돌아갑니다.
# Vercel 에서는 폴백하지 않고 에러를 냅니다 (lib/localStore.ts 참고).

# Supabase 대시보드 > Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# vibethon_app 전용 키 — scripts/mint-supabase-key.mjs 로 발급합니다.
#
# 이 앱은 무료 플랜 프로젝트 한도 때문에 다른 용도로 쓰던 기존 Supabase 프로젝트에
# 얹혀 삽니다. 그래서 service_role(프로젝트 DB 전체의 마스터 키) 대신, vibethon
# 스키마 밖으로는 아무것도 못 하는 전용 role 키를 씁니다.
#
# ⚠️ NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요 — 붙이면 번들에 포함돼 공개됩니다.
SUPABASE_VIBETHON_KEY=

# 대체 경로: JWT 시크릿을 못 구해 전용 키를 만들지 못한 경우에만 service_role 키를
# 여기에 넣습니다. 호스트 프로젝트 데이터까지 열리는 키라는 점을 알고 쓰세요.
# SUPABASE_SERVICE_ROLE_KEY=
