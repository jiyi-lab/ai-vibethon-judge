# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# .env* 는 .gitignore 대상이라 저장소에 올라가지 않습니다.

# Supabase 대시보드 > Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase 대시보드 > Settings > API Keys > service_role (secret)
#
# ⚠️ RLS 를 우회하는 마스터 키입니다. 서버에서만 쓰이며 브라우저로 내려가지 않습니다.
#    NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요 — 붙이면 번들에 포함돼 공개됩니다.
SUPABASE_SERVICE_ROLE_KEY=
